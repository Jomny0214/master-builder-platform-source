# Paddle environment selection. Use sandbox for development and production for live.
PADDLE_ENV=sandbox

# Catalog IDs are different in sandbox and live.
PADDLE_PRODUCT_ID=pro_example
PADDLE_PRICE_ID=pri_example

# Sandbox credentials.
PADDLE_API_KEY=pdl_sdbx_apikey_example
PADDLE_CLIENT_TOKEN=test_example
PADDLE_WEBHOOK_SECRET=pdl_ntfset_example

# Live credentials. Keep these in Replit Secrets, never source control.
PADDLE_LIVE_API_KEY=pdl_live_apikey_example
PADDLE_LIVE_CLIENT_TOKEN=live_example
PADDLE_LIVE_WEBHOOK_SECRET=pdl_ntfset_example

# Checkout metadata signing.
SESSION_SECRET=replace_with_a_long_random_secret